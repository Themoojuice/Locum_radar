# Node 24+. By default the app binds to 127.0.0.1 and uses a local SQLite database.
APP_ORIGIN=http://127.0.0.1:3000
# Optional local password; both are mandatory for a non-loopback APP_ORIGIN.
APP_PASSWORD=
SESSION_SECRET=
# Leave empty for SQLite. Use a dedicated PostgreSQL database for private hosting.
DATABASE_URL=
SQLITE_PATH=./data/locum-radar.sqlite
# Enable only after reviewing each source's recorded access permission.
COLLECTOR_ENABLED=false
# Adzuna API keys (developer.adzuna.com). Personal research use; see docs/source-acquisition.md.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Pause between requests to one source, in milliseconds (a site's crawl-delay wins if longer).
COLLECTOR_PAGE_DELAY_MS=1500
# Source ids whose access you have permission for; they start approved and enabled.
# Example: APPROVED_SOURCES=medrecruit,1medical,wavelength
APPROVED_SOURCES=
# Optional note stored as the permission evidence for those sources.
APPROVAL_NOTE=
# Valid collected listings go straight to the feed; set false to review every record first.
COLLECTOR_AUTO_IMPORT=true
# Maximum 1Medical job pages read per run (each is about 1 MB).
ONEMEDICAL_DETAIL_LIMIT=150
# Folder of exported recruiter emails (.eml) for `npm run import-mail`.
MAILDROP_DIR=
